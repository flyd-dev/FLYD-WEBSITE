{
  "name": "flyd-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "prebuild": "node scripts/make-team-thumbs.mjs && node scripts/make-logo-thumbs.mjs",
    "postbuild": "node scripts/sjekk-bekreft.mjs",
    "sjekk:bekreft": "node scripts/sjekk-bekreft.mjs --alltid",
    "build:utkast": "FLYD_UTKAST=1 next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "export": "next build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "11.11.1",
    "lucide-react": "0.447.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "safari >= 14"
  ],
  "devDependencies": {
    "@types/node": "20.16.5",
    "@types/react": "18.3.8",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2"
  }
}
